MODEL_API_KEY=
# Independent local demo token; never use production credentials.
AXLE_DEMO_TOKEN=

# Local browser only: local (default) or remote. No automatic fallback.
AXLE_BROWSER_EVALUATOR=local
# Required only for remote browser mode. Token is separate from AXLE_DEMO_TOKEN.
AXLE_REMOTE_BASE_URL=https://axle-api-demo.flyboxfly.com
AXLE_REMOTE_API_TOKEN=
